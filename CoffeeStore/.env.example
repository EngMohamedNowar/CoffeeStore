# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# SQL Server SA password. Must satisfy the SQL Server complexity policy:
# 8+ chars, and at least 3 of {upper, lower, digit, symbol}.
# Generate one with:  pwgen -s 24 1   (or any password manager)
MSSQL_SA_PASSWORD=

# JWT signing key. At least 32 bytes of entropy, base64 or long random string.
# Generate one with:  dotnet user-secrets set "Jwt:SigningKey" <value>
# Every caller that presents a token signed with a different key will be rejected,
# so changing this logs everybody out.
JWT_SIGNING_KEY=
